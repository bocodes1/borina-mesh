# Anthropic API — OPTIONAL
# If set: uses API directly (pay-per-token).
# If unset: falls back to `claude` CLI subprocess (uses Claude Max subscription).
# On the Mac Mini, leave this blank — the `claude` CLI is already authenticated.
ANTHROPIC_API_KEY=

# Database
DATABASE_URL=sqlite:///./borina.db

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Obsidian vault root — reports auto-copy here for cross-machine sync.
# The dashboard Files tab merges local reports/ with {vault}/reports/,
# so artifacts generated on either PC or Mac Mini show up on both.
# Mac Mini: /Users/clawd/.openclaw/workspace
# PC:       C:/Users/wenbo/OneDrive/Documents/remote
OBSIDIAN_VAULT_PATH=/Users/clawd/.openclaw/workspace

# Absolute path to the `claude` CLI used by the tmux supervisor.
# Resolved order: this env var → shutil.which('claude') → known fallbacks.
CLAUDE_CLI_PATH=/Users/clawd/.local/bin/claude

# ─── Finance agent data sources ───────────────────────────────────────────
# Polygon.io — price/volume history. Used for the >2% movement screen and
# 5-year multiple history. Get a key at https://polygon.io/.
POLYGON_API_KEY=

# Financial Modeling Prep — fundamentals (P/E, EV/EBITDA, peers, earnings
# calendar). Get a key at https://site.financialmodelingprep.com/.
FMP_API_KEY=

# FRED — macro context (10Y yield, fed funds, VIX, DXY). Free key at
# https://fred.stlouisfed.org/docs/api/api_key.html.
FRED_API_KEY=

# SEC EDGAR — no key required, but the API needs a User-Agent header. Set
# this to "your name your-email@example.com" per their fair-use policy:
# https://www.sec.gov/os/accessing-edgar-data
SEC_EDGAR_USER_AGENT=Borina Mesh research@example.com

# ─── Life-OS integrations (Finance / Daily / Calendar tabs) ───────────────
# Each is optional. When a key is blank the matching tab shows "Connect X"
# instead of crashing — the app never requires these to boot.

# Market data (quotes/history/fundamentals/news). Finnhub/Alpha Vantage-style.
MARKET_DATA_API_KEY=

# Brokerage / portfolio — READ-ONLY positions + balances. No trading is ever
# performed by this app; these only read.
BROKERAGE_API_KEY=
BROKERAGE_API_SECRET=

# Crypto wallet — READ-ONLY balances by public address (comma-separated).
WALLET_ADDRESSES=

# Polymarket — read-only surface of the local bot's dashboard API.
POLYMARKET_API_URL=http://localhost:8080

# Google Calendar — OAuth (read + user-initiated create only). Tokens stored
# server-side after consent; never placed in URLs.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_ACCESS_TOKEN=

# Weather — free provider keyed by home location.
WEATHER_API_KEY=
HOME_LAT=
HOME_LON=

# ─── Autonomous Telegram dispatch (§8b) ───────────────────────────────────
# Bo messages the bot → intent router → agent → PDF back. SECURITY-CRITICAL:
# only chat_ids in the allow-list can dispatch; an empty/misconfigured list
# rejects everything (fail closed). The secret token is validated on every
# webhook call.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=
MESH_PUBLIC_HOST=
INTENT_CONFIDENCE_THRESHOLD=0.6
